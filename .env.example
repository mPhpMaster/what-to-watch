# Copy to .env.local and fill in. .env.local is gitignored.

# --- Admin panel (/admin) ---
# Without both of these the admin panel shows a setup notice instead of a login.
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Posters (optional) ---
# Only used by `npm run enrich`, never at runtime. Free key from themoviedb.org.
TMDB_API_KEY=

# --- Hosting on Vercel (optional) ---
# Vercel's filesystem is read-only, so admin writes need Blob storage.
BLOB_READ_WRITE_TOKEN=
